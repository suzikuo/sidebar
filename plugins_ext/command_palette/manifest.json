{
  "manifest_version": 2,
  "id": "command_palette",
  "name": "命令面板",
  "version": "1.0.0",
  "description": "统一搜索和执行应用、书签、SSH 与常用系统命令。",
  "author": "Agile Tiles",
  "entry": "plugin.py",
  "class": "CommandPalettePlugin",
  "api_version": "1.0",
  "permissions": ["ui", "state"],
  "compatibility": {
    "app": ">=1.0.0",
    "python_abi": "cp311",
    "platform": "win_amd64"
  },
  "dependencies": {
    "host": ["PySide6==6.11.1", "PySide6-Fluent-Widgets==1.11.0"],
    "python": [],
    "plugins": {}
  },
  "files": {},
  "native_modules": [],
  "requires_restart": false,
  "ui": {"type": "native"},
  "capabilities": ["command.catalog", "command.execute", "backup.read", "backup.write"]
}
