{
  "manifest_version": 2,
  "id": "system_monitor",
  "name": "系统监控",
  "version": "1.0.0",
  "description": "低开销查看 CPU、内存、磁盘和进程占用。",
  "author": "Agile Tiles",
  "entry": "plugin.py",
  "class": "SystemMonitorPlugin",
  "api_version": "1.0",
  "permissions": ["ui", "state"],
  "compatibility": {
    "app": ">=1.0.0",
    "python_abi": "cp311",
    "platform": "win_amd64"
  },
  "dependencies": {
    "host": ["PySide6==6.11.1", "PySide6-Fluent-Widgets==1.11.0"],
    "python": [],
    "plugins": {}
  },
  "files": {},
  "native_modules": [],
  "requires_restart": false,
  "ui": {"type": "native"},
  "capabilities": ["backup.read", "backup.write"]
}
