{
  "manifest_version": 2,
  "id": "backup_restore",
  "name": "备份与恢复",
  "version": "1.0.0",
  "description": "备份插件导出快照与用户选择的文件。",
  "author": "Agile Tiles",
  "entry": "plugin.py",
  "class": "BackupRestorePlugin",
  "api_version": "1.0",
  "permissions": ["ui", "state", "filesystem"],
  "compatibility": {
    "app": ">=1.0.0",
    "python_abi": "cp311",
    "platform": "win_amd64"
  },
  "dependencies": {
    "host": ["PySide6==6.11.1", "PySide6-Fluent-Widgets==1.11.0"],
    "python": [],
    "plugins": {}
  },
  "files": {},
  "native_modules": [],
  "requires_restart": false,
  "ui": {"type": "native"},
  "capabilities": ["backup.read", "backup.write"]
}
